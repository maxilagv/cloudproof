{
  "name": "@cloudproof/cli",
  "version": "0.0.1",
  "description": "CLI del Evidence Plane determinista de CloudProof",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "bin": {
    "cloudproof": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@cloudproof/config": "workspace:*",
    "@cloudproof/docker-executor": "workspace:*",
    "@cloudproof/http-recorder": "workspace:*",
    "@cloudproof/plugin-github-actions": "workspace:*",
    "@cloudproof/plugin-node": "workspace:*",
    "@cloudproof/plugin-postgres": "workspace:*",
    "@cloudproof/plugin-prisma": "workspace:*",
    "@cloudproof/plugin-sdk": "workspace:*",
    "@cloudproof/policy-engine": "workspace:*",
    "@cloudproof/postgres-verifier": "workspace:*",
    "@cloudproof/schema": "workspace:*",
    "commander": "^13.0.0",
    "semver": "^7.7.0",
    "yaml": "^2.9.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/semver": "^7.7.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  }
}
